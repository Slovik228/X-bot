# Database URL is set in Dockerfile ENV (file:/app/db/custom.db).
# Do NOT override here — the sandbox path (file:/home/z/my-project/...) breaks Fly.

# ---- AI API (Groq — free, fast, works from any IP) ----
# AI_API_KEY is set via Fly secrets (NOT in this file — GitHub blocks API keys).
# Run: fly secrets set AI_API_KEY=gsk_your_key --app slopius-web
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_VISION_MODEL=openai/gpt-oss-120b

# ---- Twitter API v2 (real X integration) — @kemocalls bot ----
TWITTER_BOT_HANDLE=kemocalls

# Consumer Keys (OAuth 1.0a app credentials)
TWITTER_API_KEY=VXvAPP4DCH15nDyMJFX48LYPR
TWITTER_API_KEY_SECRET=xVoAvThGBbOf3kGu1rQuJWpVzK7zXVawwV2DxOhWJDhvjwu4Gq

# Bearer token (app-only, for reads: search mentions, fetch tweets)
TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAAAYL%2FgEAAAAA2rqa5fPbZ%2BWu19%2FrQx6WHzxrPrM%3DvqzP9ehDIivz1ugCmSk6F8z5XbgDQnodIigYNuw6gUMFElVe0L

