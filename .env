DATABASE_URL=file:/app/db/custom.db

# ---- AI API (Groq — free, fast, works from any IP) ----
# AI_API_KEY is set via Fly secrets (NOT in this file — GitHub blocks API keys).
# Run: fly secrets set AI_API_KEY=gsk_your_key --app slopius-web
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_VISION_MODEL=llama-3.2-90b-vision-preview

# ---- Twitter API v2 (real X integration) — Slopius bot ----
TWITTER_BOT_HANDLE=Slopius

# Consumer Keys (OAuth 1.0a app credentials)
TWITTER_API_KEY=RHAbI891S5qDTeiBcXo82hAvY
TWITTER_API_KEY_SECRET=Va8JuooBm3jXy4Ocx2k6zv2KKCjEsNghn5yK1KWPnzVzlevwAJ

# Bearer token (app-only, for reads: search mentions, fetch tweets)
TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAAF6n%2FAEAAAAAsuFbna22y34XD3GL%2Fo8ngQit784%3D31excD6yZngF7XOdFf0JKOHyv1cZJ2bVHUPslUKeDtB0kOwsHU

# OAuth 1.0a user-context Access Token + Secret (for POSTING tweets).
# These do NOT expire — bot runs 24/7.
TWITTER_ACCESS_TOKEN=2088347479381082112-4DootJ1P5WXoBDy6Gae5wvCxXlvvWG
TWITTER_ACCESS_TOKEN_SECRET=7siUxou1sCpUgn83FXVfd4gYAvQhAxVRK7bVLL23Ezh7y

