# Copy this file to .env and fill in your real Twitter API credentials.
# Get them from https://developer.x.com/ → your app → Keys and tokens.

DATABASE_URL=file:/app/db/custom.db

# ---- Twitter API v2 ----
# Your bot's X handle (without @). The listener searches for mentions of this handle.
TWITTER_BOT_HANDLE=YourBotHandle

# Consumer Keys (OAuth 1.0a app credentials) — from "Consumer Keys" section
TWITTER_API_KEY=your_consumer_key_here
TWITTER_API_KEY_SECRET=your_consumer_key_secret_here

# Bearer token (app-only, for reads: search mentions, fetch tweets)
# Keep the URL-encoded form exactly as X shows it.
TWITTER_BEARER_TOKEN=your_bearer_token_here

# OAuth 1.0a Access Token + Secret — from "Authentication Tokens" section.
# REQUIRED for posting reply tweets. These do NOT expire.
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Shared secret between twitter-listener and the Next.js ingest route.
# Set the SAME value in both services. Change to a random string in production.
TWITTER_INTERNAL_SECRET=change-me-to-a-random-string

# URL of this Next.js app (for the listener to call the ingest endpoint).
NEXT_APP_URL=http://localhost:3000

# --- Production-only (set when deploying) ---
# URL of the bot-relay service (for the Next.js app to push socket events).
# BOT_RELAY_URL=http://relay:3003/internal/broadcast
# Public URL of the bot-relay (for the browser to connect via socket.io).
# NEXT_PUBLIC_SOCKET_URL=https://your-relay-host
